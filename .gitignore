node_modules/
courses/*/out/
# 시각 검토용 PNG(tools/review-pdf.sh). 저장소 안에 두어야 LLM이 읽는다
out/
.DS_Store
courses/swqm/output/
engine/.cache/
engine/production/.cache/

# 원전 텍스트 캐시(저작물 원문, tools/verify-quote.js)
references/sources/
# 사용자가 넣은 받은 원문(PDF·추출 텍스트 — 저작물 원문). 인용 확인용이며 커밋하지 않는다
references/inputs/

# 테스트 실행용 라이브러리(Maven Central에서 받는다, 각 run-tests.sh 참조)
courses/*/sessions/code/**/lib/*.jar

# PowerPoint가 덱을 열어 둔 동안 만드는 잠금 파일
~$*.pptx

# 로컬 정리 백업: 실제 작업물은 별도로 추적하고 복구용 압축본만 제외한다
.codex/archives/
# 로컬 Python 실행 환경·자동 생성물
.venv/
__pycache__/
*.pyc

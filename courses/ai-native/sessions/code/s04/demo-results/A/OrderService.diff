+        Order order = repository.findBy(number);
+        // 이미 결제된 주문에 승인을 다시 요청해 이중 결제가 되지 않게 먼저 막는다.
+        if (order.status() != OrderStatus.PENDING_PAYMENT) throw new IllegalStateException("결제대기 주문만 결제할 수 있다");
